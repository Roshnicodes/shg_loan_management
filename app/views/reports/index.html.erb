<% content_for :page_title, "Reports" %>

<section class="panel report-panel">
  <div class="panel-header">
    <div>
      <p class="eyebrow">Reports</p>
      <h2>Loan Collection Report</h2>
    </div>
    <div class="action-row">
      <%= link_to "Download Excel", export_reports_path(request.query_parameters.except(:commit, :refresh_filters, :page)), class: "secondary-link" %>
      <%= server_search_box(reports_path, placeholder: "Search report...") %>
    </div>
  </div>

  <%= form_with url: reports_path, method: :get, class: "filter-grid report-filter-grid", data: { controller: "location-select" } do |form| %>
    <label><span>From Date</span><%= form.date_field :date_from, value: params[:date_from] %></label>
    <label><span>To Date</span><%= form.date_field :date_to, value: params[:date_to] %></label>
    <% if show_report_state_filter? %>
      <%= multi_filter_select(form, :state_id, "State", @states.map { |state| [state.name, state.id] }, selected_values: @selected_state_ids, data: { location_select_target: "state", action: "location-select#stateChanged" }, placeholder: "All states") %>
    <% end %>
    <% if show_report_district_filter? %>
      <%= multi_filter_select(form, :district_id, "District", district_filter_options(@districts), selected_values: @selected_district_ids, data: { location_select_target: "district", action: "location-select#districtChanged" }, placeholder: "All districts") %>
    <% end %>
    <% if show_report_block_filter? %>
      <%= multi_filter_select(form, :block_id, "Block", block_filter_options(@blocks), selected_values: @selected_block_ids, data: { location_select_target: "block", action: "location-select#blockChanged" }, placeholder: "All blocks") %>
    <% end %>
    <% if show_report_village_filter? %>
      <%= multi_filter_select(form, :village_id, "Village", village_filter_options(@villages), selected_values: @selected_village_ids, data: { location_select_target: "village", action: "location-select#villageChanged" }, placeholder: "All villages") %>
    <% end %>
    <% if show_report_user_filter? %>
      <%= multi_filter_select(form, :user_id, "CRP", user_filter_options(@crps), selected_values: @selected_user_ids, data: { location_select_target: "crp", action: "location-select#userChanged" }, placeholder: "All CRPs") %>
    <% end %>
    <%= multi_filter_select(form, :shg_id, "SHG / ID / Village", shg_filter_options(@shgs), selected_values: @selected_shg_ids, data: { location_select_target: "shg", action: "location-select#shgChanged" }, placeholder: "All SHG") %>
    <%= multi_filter_select(form, :member_id, "SHG Member", member_filter_options(@members), selected_values: @selected_member_ids, data: { location_select_target: "member", action: "location-select#memberChanged" }, placeholder: "All members") %>
    <%= multi_filter_select(form, :loan_id, "Loan", loan_filter_options(@loan_filter_records), selected_values: @selected_loan_ids, data: { location_select_target: "loan" }, placeholder: "All loans") %>
    <%= multi_filter_select(form, :loan_status_id, "Loan Status", @loan_statuses.map { |status| [status.name, status.id] }, selected_values: filter_param_values(:loan_status_id), placeholder: "All loan status") %>
    <%= multi_filter_select(form, :collection_status, "Collection", [ [ "Pending", "pending" ], [ "Closed", "closed" ], [ "Paid Installment", "paid_installment" ] ], selected_values: filter_param_values(:collection_status), placeholder: "All collection") %>
    <div class="filter-actions">
      <%= link_to "Clear", reports_path, class: "secondary-link" %>
      <%= form.submit "Apply", class: "primary-button" %>
    </div>
  <% end %>

  <% if @report_ready %>
    <div id="<%= ApplicationController::RESULTS_ANCHOR %>" class="searchable-table compact-search-results">
      <% if @loans.blank? %><div class="table-empty-state">No matching report records found.</div><% end %>
      <div class="table-wrap">
        <table class="loan-import-table">
          <thead>
            <tr>
              <% if show_report_state_filter? %><th>State</th><% end %>
              <% if show_report_district_filter? %><th>District</th><% end %>
              <% if show_report_block_filter? %><th>Block</th><% end %>
              <th>Village</th>
              <% if show_report_user_filter? %><th>CRP</th><% end %>
              <th>SHG / ID / Village</th>
              <th>Member</th>
              <th>Loan No</th>
              <th>Product Code</th>
              <th>Status</th>
              <th>Collection</th>
              <th>Total</th>
              <th>Paid</th>
              <th>Pending</th>
              <th>Installment Paid</th>
              <th>Installment Pending</th>
              <th>Action</th>
            </tr>
          </thead>
          <tbody>
            <% @loans.each do |loan| %>
              <% amount = @loan_amounts.fetch(loan.id) %>
              <tr>
                <% if show_report_state_filter? %><td><%= loan.shg.state.name %></td><% end %>
                <% if show_report_district_filter? %><td><%= loan.shg.district.name %></td><% end %>
                <% if show_report_block_filter? %><td><%= loan.shg.block.name %></td><% end %>
                <td><%= loan.shg.village.name %></td>
                <% if show_report_user_filter? %><td><%= loan.source_crp_name.presence || loan.created_by&.name || "-" %></td><% end %>
                <td><%= loan.shg.display_name %></td>
                <td><%= loan.shg_member.name %></td>
                <td><%= loan.shg_member.loan_no.presence || "-" %></td>
                <td><%= product_code_label(loan.product) %></td>
                <td><span class="status"><%= report_loan_status(loan, amount) %></span></td>
                <td><span class="status"><%= report_collection_status(amount) %></span></td>
                <td><%= number_to_currency(amount[:total_payable], unit: "₹") %></td>
                <td><%= number_to_currency(amount[:paid_amount], unit: "₹") %></td>
                <td><%= number_to_currency(amount[:pending_amount], unit: "₹") %></td>
                <td><%= amount[:paid_installments] %></td>
                <td><%= amount[:pending_installments] %></td>
                <td><%= link_to "Details", shg_loan_path(loan) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>

    <%= pagination_controls("report records") %>
  <% end %>
</section>
