<% content_for :page_title, "Visit Work" %>
<% index_params = request.query_parameters %>

<section class="panel">
  <div class="panel-header">
    <div><p class="eyebrow">Field Visits</p><h2>Visit Work</h2></div>
    <div class="action-row">
      <%= link_to "Download CSV", export_visit_records_path(request.query_parameters), class: "secondary-link" %>
      <% if can_bulk_delete_records? %>
        <%= form_with url: bulk_disable_visit_records_path(request.query_parameters), method: :patch, id: "bulk-disable-visits" do |form| %>
          <%= form.submit "Disable Selected", class: "warning-link", data: { turbo_confirm: "Disable selected visits?" } %>
        <% end %>
      <% end %>
      <% if can_create_records? %><%= link_to "Add Visit", new_visit_record_path(index_params), class: "primary-link" %><% end %>
      <%= server_search_box(visit_records_path, placeholder: "Search visits...") %>
    </div>
  </div>

  <%= form_with url: visit_records_path, method: :get, class: "filter-grid visit-filter-grid", data: { controller: "location-select" } do |form| %>
    <%= form.hidden_field :q, value: params[:q] if params[:q].present? %>
    <label><span>From Date</span><%= form.date_field :date_from, value: params[:date_from] %></label>
    <label><span>To Date</span><%= form.date_field :date_to, value: params[:date_to] %></label>
    <% if can_filter_visit_state_district_crp? %>
      <% if current_user&.admin? || readonly_admin? %>
        <%= multi_filter_select(form, :assistant_id, "Assistant Admin", @assistant_admins.map { |user| [user.name, user.id] }, selected_values: filter_param_values(:assistant_id), placeholder: "All Assistant Admin") %>
      <% end %>
      <%= multi_filter_select(form, :dc_id, "District Coordinator", user_filter_options(@district_coordinators), selected_values: filter_param_values(:dc_id), data: { location_select_target: "dc", action: "location-select#userChanged" }, placeholder: "All DC") %>
      <%= multi_filter_select(form, :crp_id, "CRP", user_filter_options(@crps), selected_values: filter_param_values(:crp_id), data: { location_select_target: "crp", action: "location-select#userChanged" }, placeholder: "All CRP") %>
    <% end %>
    <% if can_filter_visit_state_district_crp? %>
      <%= multi_filter_select(form, :state_id, "State", @states.map { |state| [state.name, state.id] }, selected_values: filter_param_values(:state_id), data: { location_select_target: "state", action: "location-select#stateChanged" }, placeholder: "All states") %>
      <%= multi_filter_select(form, :district_id, "District", district_filter_options(@districts), selected_values: filter_param_values(:district_id), data: { location_select_target: "district", action: "location-select#districtChanged" }, placeholder: "All districts") %>
    <% end %>
    <%= multi_filter_select(form, :block_id, "Block", block_filter_options(@blocks), selected_values: filter_param_values(:block_id), data: { location_select_target: "block", action: "location-select#blockChanged" }, placeholder: "All blocks") %>
    <%= multi_filter_select(form, :village_id, "Village", village_filter_options(@villages), selected_values: filter_param_values(:village_id), data: { location_select_target: "village", action: "location-select#villageChanged" }, placeholder: "All villages") %>
    <%= multi_filter_select(form, :shg_id, "SHG", shg_filter_options(@shgs), selected_values: filter_param_values(:shg_id), data: { location_select_target: "shg", action: "location-select#shgChanged" }, placeholder: "All SHG") %>
    <%= multi_filter_select(form, :approval_status, "Approval", VisitRecord::APPROVAL_STATUSES.map { |status| [ status.titleize, status ] }, selected_values: filter_param_values(:approval_status), placeholder: "All status") %>
    <div class="filter-actions">
      <%= link_to "Clear", visit_records_path(clear_filters: 1), class: "secondary-link" %>
      <%= form.submit "Apply", class: "primary-button" %>
    </div>
  <% end %>

  <div id="<%= ApplicationController::RESULTS_ANCHOR %>" class="searchable-table compact-search-results">
    <% if @visit_records.blank? %><div class="table-empty-state">No matching visits found.</div><% end %>
    <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <% if can_bulk_delete_records? %><th class="select-column"><%= check_box_tag "select_all_visits", "1", false, data: { bulk_select_all: true, bulk_select_form: "bulk-disable-visits" }, aria: { label: "Select all visits on this page" } %></th><% end %>
          <th>Visit Date</th>
          <th>Visit No.</th>
          <th>Village / SHG / Member</th>
          <th>Product</th>
          <th>Photo</th>
          <th>Approval</th>
          <th>Status</th>
          <th>DC Approval</th>
          <th>Assistant Approval</th>
          <th>Created By</th>
          <th>Action</th>
        </tr>
      </thead>
      <tbody>
        <% @visit_records.each do |visit| %>
          <tr>
            <% if can_bulk_delete_records? %><td><%= check_box_tag "ids[]", visit.id, false, form: "bulk-disable-visits", disabled: !visit.active? %></td><% end %>
            <td><%= visit.visit_date %></td>
            <td><%= visit.visit_label %></td>
            <td>
              <strong><%= visit.village.name %></strong><br>
              <%= link_to visit.shg.display_name, visit.shg %><br>
              <small><%= visit.shg_member.name %></small>
            </td>
            <td><%= product_code_label(visit.product) %></td>
            <td>
              <% if visit.photo.attached? %>
                <% if visit.photo.image? %>
                  <%= image_tag url_for(visit.photo), class: "table-photo", alt: "Visit photo", loading: "lazy", decoding: "async" %>
                <% end %>
                <%= link_to "Open", url_for(visit.photo), target: "_blank", rel: "noopener" %>
                <%= link_to "Download", rails_blob_path(visit.photo, disposition: "attachment") %>
              <% else %>
                <span class="muted-text">No photo</span>
              <% end %>
            </td>
            <td><span class="status <%= visit.approval_status %>"><%= visit.approval_label %></span></td>
            <td><span class="status <%= visit.active? ? "approved" : "rejected" %>"><%= visit.active? ? "Active" : "Inactive" %></span></td>
            <td><%= visit.dc_approved_by&.name || "-" %><% if visit.dc_approved_at.present? %><br><small><%= l(visit.dc_approved_at, format: :short) %></small><% end %></td>
            <td><%= visit.assistant_approved_by&.name || "-" %><% if visit.assistant_approved_at.present? %><br><small><%= l(visit.assistant_approved_at, format: :short) %></small><% end %></td>
            <td><%= visit.created_by&.name || "-" %></td>
            <td>
              <div class="action-row" data-controller="visit-review">
                <button type="button" class="secondary-link compact-button" data-action="visit-review#open">Review</button>
                <% if can_manage_visit?(visit) %>
                  <%= link_to "Edit", edit_visit_record_path(visit, index_params) %>
                <% end %>
                <% if can_bulk_delete_records? && visit.active? %>
                  <%= button_to "Disable", disable_visit_record_path(visit, index_params), method: :patch, class: "warning-link", form: { data: { turbo_confirm: "Disable this visit?" } } %>
                <% elsif !visit.active? %>
                  <span class="muted-cell">Disabled</span>
                <% end %>

                <dialog class="visit-dialog" data-visit-review-target="dialog">
                  <div class="visit-dialog-shell">
                    <div class="visit-dialog-header">
                      <div>
                        <p class="eyebrow">Visit Review</p>
                        <h3><%= visit.shg_member.name %></h3>
                        <span class="status <%= visit.approval_status %>"><%= visit.approval_label %></span>
                      </div>
                      <button type="button" class="dialog-close" data-action="visit-review#close" aria-label="Close">X</button>
                    </div>

                    <div class="visit-review-grid">
                      <div class="visit-review-media">
                        <% if visit.photo.attached? %>
                          <% if visit.photo.image? %>
                            <div class="visit-photo-tools" aria-label="Photo rotation controls">
                              <button type="button" class="secondary-link compact-button" data-action="visit-review#rotateLeft">Rotate Left</button>
                              <button type="button" class="secondary-link compact-button" data-action="visit-review#rotateRight">Rotate Right</button>
                              <button type="button" class="secondary-link compact-button" data-action="visit-review#resetRotation">Reset</button>
                            </div>
                            <%= tag.img class: "visit-review-photo", alt: "Visit photo", data: { visit_review_target: "image", src: url_for(visit.photo) } %>
                          <% else %>
                            <div class="document-preview">
                              <strong><%= visit.photo.filename.to_s %></strong>
                              <%= link_to "Open Document", url_for(visit.photo), target: "_blank", rel: "noopener", class: "secondary-link" %>
                              <%= link_to "Download", rails_blob_path(visit.photo, disposition: "attachment"), class: "secondary-link" %>
                            </div>
                          <% end %>
                        <% else %>
                          <div class="document-preview">
                            <strong>No photo/document uploaded</strong>
                          </div>
                        <% end %>
                      </div>

                      <div class="visit-review-content">
                        <div class="review-section">
                          <h4>Location</h4>
                          <dl class="compact-detail-list">
                            <dt>Visit Date</dt><dd><%= visit.visit_date %></dd>
                            <dt>Visit No.</dt><dd><%= visit.visit_label %></dd>
                            <dt>Product</dt><dd><%= product_code_label(visit.product) %></dd>
                            <dt>Village</dt><dd><%= visit.village.name %></dd>
                            <dt>SHG</dt><dd><%= visit.shg.display_name %></dd>
                            <dt>Created By</dt><dd><%= visit.created_by&.display_name || "-" %></dd>
                          </dl>
                        </div>

                        <div class="review-section">
                          <h4>Member</h4>
                          <dl class="compact-detail-list">
                            <dt>Name</dt><dd><%= visit.shg_member.name %></dd>
                            <dt>Loan No</dt><dd><%= visit.shg_member.loan_no.presence || "-" %></dd>
                            <dt>Mobile</dt><dd><%= visit.shg_member.mobile.presence || "-" %></dd>
                            <dt>Address</dt><dd><%= visit.shg.borrower_address || "-" %></dd>
                          </dl>
                        </div>

                        <div class="review-section">
                          <h4>Visit Notes</h4>
                          <dl class="compact-detail-list">
                            <dt>Purpose</dt><dd><%= simple_format(visit.purpose.presence || "-") %></dd>
                            <dt>Observations</dt><dd><%= simple_format(visit.observations.presence || "-") %></dd>
                            <dt>Remarks</dt><dd><%= simple_format(visit.approval_remarks.presence || "-") %></dd>
                          </dl>
                        </div>

                        <div class="review-section">
                          <h4>Approval Trail</h4>
                          <dl class="compact-detail-list">
                            <dt>DC Approval</dt><dd><%= visit.dc_approved_by&.display_name || "-" %><% if visit.dc_approved_at.present? %><br><small><%= l(visit.dc_approved_at, format: :short) %></small><% end %></dd>
                            <dt>Assistant Approval</dt><dd><%= visit.assistant_approved_by&.display_name || "-" %><% if visit.assistant_approved_at.present? %><br><small><%= l(visit.assistant_approved_at, format: :short) %></small><% end %></dd>
                          </dl>
                        </div>
                      </div>
                    </div>

                    <% if can_approve_visit?(visit) %>
                      <div class="modal-approval-bar">
                        <%= button_to "Approve", approve_visit_record_path(visit, index_params), method: :patch, class: "success-link" %>
                        <%= form_with url: return_for_correction_visit_record_path(visit, index_params), method: :patch, class: "modal-approval-form" do |form| %>
                          <%= form.text_field :approval_remarks, placeholder: "Return remarks" %>
                          <%= form.submit "Return", class: "warning-link" %>
                        <% end %>
                        <%= form_with url: reject_visit_record_path(visit, index_params), method: :patch, class: "modal-approval-form" do |form| %>
                          <%= form.text_field :approval_remarks, placeholder: "Reject remarks" %>
                          <%= form.submit "Reject", class: "danger-link" %>
                        <% end %>
                      </div>
                    <% end %>
                  </div>
                </dialog>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
    </div>
  </div>
  <%= pagination_controls("visits") %>
</section>
