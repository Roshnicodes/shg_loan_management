<% content_for :page_title, "SHG Members" %>
<% index_params = request.query_parameters %>

<section class="panel">
  <div class="panel-header">
    <div><p class="eyebrow">Members</p><h2>SHG Members</h2></div>
    <div class="action-row">
      <%= link_to "Download CSV", export_shg_members_path(request.query_parameters), class: "secondary-link" %>
      <% if can_bulk_delete_records? %>
        <%= form_with url: bulk_disable_shg_members_path(request.query_parameters), method: :patch, id: "bulk-disable-members" do |form| %>
          <%= form.submit "Disable Selected", class: "warning-link", data: { turbo_confirm: "Disable selected members?" } %>
        <% end %>
        <%= form_with url: bulk_activate_shg_members_path(request.query_parameters), method: :patch, id: "bulk-activate-members" do |form| %>
          <%= form.submit "Activate Selected", class: "success-link", data: { turbo_confirm: "Activate selected members?" } %>
        <% end %>
      <% end %>
      <% if @can_add_member %><%= link_to "Add Member", new_shg_member_path(index_params), class: "primary-link" %><% end %>
      <%= server_search_box(shg_members_path, placeholder: "Search members...") %>
    </div>
  </div>

  <%= form_with url: shg_members_path, method: :get, class: "filter-grid", data: { controller: "location-select" } do |form| %>
    <%= form.hidden_field :q, value: params[:q] if params[:q].present? %>
    <label><span>From Date</span><%= form.date_field :date_from, value: params[:date_from] %></label>
    <label><span>To Date</span><%= form.date_field :date_to, value: params[:date_to] %></label>
    <% if can_filter_member_state_district_crp? %>
      <%= multi_filter_select(form, :state_id, "State", @states.map { |state| [state.name, state.id] }, selected_values: filter_param_values(:state_id), data: { location_select_target: "state", action: "location-select#stateChanged" }, placeholder: "All states") %>
      <%= multi_filter_select(form, :district_id, "District", district_filter_options(@districts), selected_values: filter_param_values(:district_id), data: { location_select_target: "district", action: "location-select#districtChanged" }, placeholder: "All districts") %>
    <% end %>
    <%= multi_filter_select(form, :block_id, "Block", block_filter_options(@blocks), selected_values: filter_param_values(:block_id), data: { location_select_target: "block", action: "location-select#blockChanged" }, placeholder: "All blocks") %>
    <%= multi_filter_select(form, :village_id, "Village", village_filter_options(@villages), selected_values: filter_param_values(:village_id), data: { location_select_target: "village", action: "location-select#villageChanged" }, placeholder: "All villages") %>
    <%= multi_filter_select(form, :shg_id, "SHG", shg_filter_options(@shgs), selected_values: filter_param_values(:shg_id), data: { location_select_target: "shg", action: "location-select#shgChanged" }, placeholder: "All SHG") %>
    <% if can_filter_member_state_district_crp? %>
      <%= multi_filter_select(form, :crp_id, "CRP", user_filter_options(@crps), selected_values: filter_param_values(:crp_id), data: { location_select_target: "crp", action: "location-select#userChanged" }, placeholder: "All CRP") %>
    <% end %>
    <div class="filter-actions">
      <%= link_to "Clear", shg_members_path(clear_filters: 1), class: "secondary-link" %>
      <%= form.submit "Apply", class: "primary-button" %>
    </div>
  <% end %>

  <div id="<%= ApplicationController::RESULTS_ANCHOR %>" class="searchable-table compact-search-results">
    <% if @members.blank? %><div class="table-empty-state">No matching members found.</div><% end %>
    <div class="table-wrap">
    <table>
      <thead><tr><% if can_bulk_delete_records? %><th class="select-column"><%= check_box_tag "select_all_members", "1", false, data: { bulk_select_all: true, bulk_select_forms: "bulk-disable-members bulk-activate-members" }, aria: { label: "Select all members on this page" } %></th><% end %><th>Name</th><th>Spouse/Father</th><th>SHG</th><th>Loan No</th><th>Aadhaar</th><th>Work/Activity</th><th>Status</th><th>Monthly HH Income</th><th>Mobile</th><th>Action</th></tr></thead>
      <tbody>
        <% @members.each do |member| %>
          <tr>
            <% if can_bulk_delete_records? %><td><%= check_box_tag "ids[]", member.id, false, form: (member.active? ? "bulk-disable-members" : "bulk-activate-members") %></td><% end %>
            <td><%= link_to member.name, shg_member_path(member, index_params) %></td>
            <td><%= member.spouse_father_name.presence || "-" %></td>
            <td><%= member.shg.display_name %></td>
            <td><%= member.loan_no.presence || "-" %></td>
            <td><%= member.aadhaar_no.presence || "-" %></td>
            <td><%= member.work_activity_name || "-" %></td>
            <td><span class="status <%= member.active? ? "approved" : "rejected" %>"><%= member.active? ? "Active" : "Inactive" %></span></td>
            <td><%= member.monthly_income.present? ? number_to_currency(member.monthly_income, unit: "₹") : "-" %></td>
            <td><%= member.mobile %></td>
            <td><div class="action-row"><%= link_to "Details", shg_member_path(member, index_params) %><% if can_manage_shg_member?(member) %><%= link_to "Edit", edit_shg_member_path(member, index_params) %><% end %><% if can_bulk_delete_records? && member.active? %><%= button_to "Disable", disable_shg_member_path(member, index_params), method: :patch, class: "warning-link", form: { data: { turbo_confirm: "Disable this member?" } } %><% elsif can_bulk_delete_records? %><%= button_to "Activate", activate_shg_member_path(member, index_params), method: :patch, class: "success-link", form: { data: { turbo_confirm: "Activate this member?" } } %><% elsif !member.active? %><span class="muted-cell">Disabled</span><% end %></div></td>
          </tr>
        <% end %>
      </tbody>
    </table>
    </div>
  </div>
  <%= pagination_controls("members") %>
</section>
