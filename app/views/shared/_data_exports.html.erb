<% exports = DataExport.where(user: current_user, kind: kinds).where(created_at: DataExport::KEEP_FOR.ago..).recent.limit(5).to_a %>
<%= turbo_frame_tag "data-exports-#{kinds.join("-")}" do %>
  <% if exports.any? %>
    <div class="import-status-list data-export-list"
         data-controller="export-status"
         data-export-status-running-value="<%= exports.any?(&:running?) %>"
         data-export-status-url-value="<%= data_exports_path(kinds: kinds) %>">
      <strong class="data-export-title">Downloads</strong>
      <% exports.each do |export| %>
        <div class="import-status-item <%= export.status %>">
          <div class="import-status-main">
            <strong><%= export.label %></strong>
            <small>
              #<%= export.id %> · <%= export.running? ? "Preparing..." : export.status.titleize %> ·
              <%= l(export.created_at, format: :short) %>
              <% if export.status == "completed" %> · <%= number_with_delimiter(export.total_rows) %> rows<% end %>
            </small>
          </div>
          <div class="import-status-counts">
            <% if export.downloadable? %>
              <%= link_to "Download", download_data_export_path(export), class: "primary-link compact-button", data: { turbo: false } %>
            <% elsif export.status == "completed" %>
              <span>Expired, export again</span>
            <% end %>
          </div>
          <% if export.error_message.present? %><p><%= export.error_message %></p><% end %>
        </div>
      <% end %>
    </div>
  <% end %>
<% end %>
