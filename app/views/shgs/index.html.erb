<% content_for :page_title, "SHG Master" %>
<% index_params = request.query_parameters %>

<section class="panel">
  <div class="panel-header">
    <div>
      <p class="eyebrow">Groups</p>
      <h2>SHG Master</h2>
    </div>
    <div class="action-row">
      <%= link_to "Download CSV", export_shgs_path(request.query_parameters), class: "secondary-link" %>
      <% if can_bulk_delete_records? %>
        <%= form_with url: bulk_disable_shgs_path(request.query_parameters), method: :patch, id: "bulk-disable-shgs" do |form| %>
          <%= form.submit "Disable Selected", class: "warning-link", data: { turbo_confirm: "Disable selected SHGs?" } %>
        <% end %>
        <%= form_with url: bulk_activate_shgs_path(request.query_parameters), method: :patch, id: "bulk-activate-shgs" do |form| %>
          <%= form.submit "Activate Selected", class: "success-link", data: { turbo_confirm: "Activate selected SHGs?" } %>
        <% end %>
      <% end %>
      <% if can_create_records? %>
        <%= link_to "Add SHG", new_shg_path(index_params), class: "primary-link" %>
      <% end %>
      <%= server_search_box(shgs_path, placeholder: "Search SHGs...") %>
    </div>
  </div>

  <%= form_with url: shgs_path, method: :get, class: "filter-grid", data: { controller: "location-select" } do |form| %>
    <%= form.hidden_field :q, value: params[:q] if params[:q].present? %>
    <label><span>From Date</span><%= form.date_field :date_from, value: params[:date_from] %></label>
    <label><span>To Date</span><%= form.date_field :date_to, value: params[:date_to] %></label>
    <% if can_filter_shg_state_district_crp? %>
      <%= multi_filter_select(form, :state_id, "State", @states.map { |state| [state.name, state.id] }, selected_values: filter_param_values(:state_id), data: { location_select_target: "state", action: "location-select#stateChanged" }, placeholder: "All states") %>
      <%= multi_filter_select(form, :district_id, "District", district_filter_options(@districts), selected_values: filter_param_values(:district_id), data: { location_select_target: "district", action: "location-select#districtChanged" }, placeholder: "All districts") %>
    <% end %>
    <%= multi_filter_select(form, :block_id, "Block", block_filter_options(@blocks), selected_values: filter_param_values(:block_id), data: { location_select_target: "block", action: "location-select#blockChanged" }, placeholder: "All blocks") %>
    <%= multi_filter_select(form, :village_id, "Village", village_filter_options(@villages), selected_values: filter_param_values(:village_id), data: { location_select_target: "village", action: "location-select#villageChanged" }, placeholder: "All villages") %>
    <%= multi_filter_select(form, :approval_status, "Approval", Shg::APPROVAL_STATUSES.map { |status| [ status.titleize, status ] }, selected_values: filter_param_values(:approval_status), placeholder: "All status") %>
    <% if can_filter_shg_state_district_crp? %>
      <%= multi_filter_select(form, :crp_id, "CRP", user_filter_options(@crps), selected_values: filter_param_values(:crp_id), data: { location_select_target: "crp", action: "location-select#userChanged" }, placeholder: "All CRP") %>
      <%= multi_filter_select(form, :dc_id, "DC", user_filter_options(@district_coordinators), selected_values: filter_param_values(:dc_id), data: { location_select_target: "dc", action: "location-select#userChanged" }, placeholder: "All DC") %>
    <% end %>
    <% if current_user&.admin? || readonly_admin? %>
      <%= multi_filter_select(form, :assistant_id, "Assistant Admin", @assistant_admins.map { |user| [user.name, user.id] }, selected_values: filter_param_values(:assistant_id), placeholder: "All Assistant Admin") %>
    <% end %>
    <div class="filter-actions">
      <%= link_to "Clear", shgs_path(clear_filters: 1), class: "secondary-link" %>
      <%= form.submit "Apply", class: "primary-button" %>
    </div>
  <% end %>

  <% if @meeting_attachment_counts.present? %>
    <div class="form-help full">
      Meeting Photo: <strong><%= @meeting_attachment_counts[:photo_uploaded] %></strong> uploaded,
      <strong><%= @meeting_attachment_counts[:photo_missing] %></strong> missing.
      Meeting Register: <strong><%= @meeting_attachment_counts[:register_uploaded] %></strong> uploaded,
      <strong><%= @meeting_attachment_counts[:register_missing] %></strong> missing.
      Total SHGs: <strong><%= @meeting_attachment_counts[:total] %></strong>.
    </div>
  <% end %>

  <div id="<%= ApplicationController::RESULTS_ANCHOR %>" class="searchable-table compact-search-results">
    <% if @shgs.blank? %><div class="table-empty-state">No matching SHGs found.</div><% end %>
    <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <% if can_bulk_delete_records? %><th class="select-column"><%= check_box_tag "select_all_shgs", "1", false, data: { bulk_select_all: true, bulk_select_forms: "bulk-disable-shgs bulk-activate-shgs" }, aria: { label: "Select all SHGs on this page" } %></th><% end %>
          <th>Name</th>
          <th>Location</th>
          <th>Office</th>
          <th>Borrower Address</th>
          <th>Linkage Date</th>
          <th>Status</th>
          <th>Approval</th>
          <th>Meeting</th>
          <th>DC Approval</th>
          <th>Assistant Approval</th>
          <th>Created By</th>
          <th>Action</th>
        </tr>
      </thead>
      <tbody>
        <% @shgs.each do |shg| %>
          <tr>
            <% if can_bulk_delete_records? %><td><%= check_box_tag "ids[]", shg.id, false, form: (shg.active? ? "bulk-disable-shgs" : "bulk-activate-shgs") %></td><% end %>
            <td><%= link_to shg.display_name, shg_path(shg, index_params) %></td>
            <td><%= [shg.state.name, shg.district.name, shg.block.name, shg.village.name].join(" / ") %></td>
            <td><%= shg.office_location.presence || "-" %></td>
            <td><%= shg.borrower_short_address.presence || "-" %></td>
            <td><%= shg.linkage_date %></td>
            <td><span class="status <%= shg.active? ? "approved" : "rejected" %>"><%= shg.active? ? "Active" : "Inactive" %></span></td>
            <td><span class="status <%= shg.approval_status %>"><%= shg.approval_label %></span></td>
            <td>
              <div class="attachment-list">
                <div class="attachment-item">
                  <span>Photo</span>
                  <%= attachment_preview_link(shg.meeting_photo, "Meeting photo") %>
                </div>
                <div class="attachment-item">
                  <span>Register</span>
                  <%= attachment_preview_link(shg.meeting_register, "Meeting register") %>
                </div>
              </div>
            </td>
            <td><%= shg.dc_approved_by&.name || "-" %><% if shg.dc_approved_at.present? %><br><small><%= l(shg.dc_approved_at, format: :short) %></small><% end %></td>
            <td><%= shg.assistant_approved_by&.name || "-" %><% if shg.assistant_approved_at.present? %><br><small><%= l(shg.assistant_approved_at, format: :short) %></small><% end %></td>
            <td><%= shg.created_by&.name || "-" %></td>
            <td>
              <div class="action-row">
                <%= link_to "Details", shg_path(shg, index_params) %>
                <% if can_manage_shg?(shg) %>
                  <%= link_to "Edit", edit_shg_path(shg, index_params) %>
                <% end %>
                <% if can_bulk_delete_records? && shg.active? %>
                  <%= button_to "Disable", disable_shg_path(shg, index_params), method: :patch, class: "warning-link", form: { data: { turbo_confirm: "Disable this SHG?" } } %>
                <% elsif can_bulk_delete_records? %>
                  <%= button_to "Activate", activate_shg_path(shg, index_params), method: :patch, class: "success-link", form: { data: { turbo_confirm: "Activate this SHG?" } } %>
                <% elsif !shg.active? %>
                  <span class="muted-cell">Disabled</span>
                <% end %>
                <% if can_approve_shg?(shg) %>
                  <%= button_to "Approve", approve_shg_path(shg, index_params), method: :patch, class: "success-link" %>
                  <%= button_to "Return", return_for_correction_shg_path(shg, index_params), method: :patch, class: "warning-link" %>
                  <%= button_to "Reject", reject_shg_path(shg, index_params), method: :patch, class: "danger-link" %>
                <% end %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
    </div>
  </div>
  <%= pagination_controls("SHGs") %>
</section>
