<%= render "shared/errors", record: @shg %>
<% states = visible_states.order(:name) %>
<% district_options = district_filter_options(visible_districts.order(:name)) %>
<% block_options = block_filter_options(visible_blocks.order(:name)) %>
<% village_options = village_filter_options(visible_villages.order(:name)) %>
<% lock_state_district = (current_user&.crp? || current_user&.district_coordinator?) && @shg.state_id.present? && @shg.district_id.present? %>
<% return_params = request.query_parameters.slice(*ShgsController::SHG_INDEX_PARAMS.map(&:to_s)) %>
<% form_url = @shg.persisted? ? shg_path(@shg, return_params) : shgs_path(return_params) %>

<%= form_with model: @shg, url: form_url, class: "form-grid", data: { controller: "location-select", location_select_strict_value: true } do |form| %>
  <% if lock_state_district %>
    <label>
      <span>State</span>
      <input type="text" value="<%= @shg.state&.display_name || @shg.state&.name %>" readonly>
      <%= form.hidden_field :state_id, data: { location_select_target: "state" } %>
    </label>
    <label>
      <span>District</span>
      <input type="text" value="<%= @shg.district&.name %>" readonly>
      <%= form.hidden_field :district_id, data: { location_select_target: "district" } %>
    </label>
  <% else %>
    <label><span>State</span><%= form.collection_select :state_id, states, :id, :display_name, { prompt: "Select state" }, required: true, data: { location_select_target: "state", action: "location-select#stateChanged" } %></label>
    <label><span>District</span><%= form.select :district_id, options_for_select(district_options, @shg.district_id), { prompt: "Select district" }, required: true, data: { location_select_target: "district", action: "location-select#districtChanged" } %></label>
  <% end %>
  <label><span>Block</span><%= form.select :block_id, options_for_select(block_options, @shg.block_id), { prompt: "Select block" }, required: true, data: { location_select_target: "block", action: "location-select#blockChanged" } %></label>
  <label><span>Village</span><%= form.select :village_id, options_for_select(village_options, @shg.village_id), { prompt: "Select village" }, required: true, data: { location_select_target: "village", action: "location-select#villageChanged" } %></label>
  <label><span>SHG Name</span><%= form.text_field :name, required: true %></label>
  <label><span>Office Location</span><%= form.text_field :office_location, placeholder: "Office location" %></label>
  <label><span>Linkage Date</span><%= form.date_field :linkage_date, required: true %></label>
  <label class="full"><span>Borrower Short Address</span><%= form.text_area :borrower_short_address, rows: 3, placeholder: "Short borrower address" %></label>
  <label><span>Meeting Register</span><%= form.file_field :meeting_register, accept: ".pdf,image/png,image/jpeg,image/webp", required: !@shg.meeting_register.attached? %></label>
  <label><span>Meeting Photo</span><%= form.file_field :meeting_photo, accept: ".pdf,image/png,image/jpeg,image/webp", required: !@shg.meeting_photo.attached? %></label>
  <label class="checkbox-field"><span>Active</span><%= form.check_box :active %></label>
  <div class="form-actions"><%= link_to "Cancel", with_results_anchor(shgs_path(return_params)), class: "secondary-link" %><%= form.submit "Save SHG", class: "primary-button" %></div>
<% end %>
