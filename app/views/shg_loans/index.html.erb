<% content_for :page_title, "SHG Loans" %>
<% index_params = request.query_parameters %>

<section class="panel">
  <div class="panel-header">
    <div><p class="eyebrow">Loans</p><h2>SHG Loan Forms</h2></div>
    <div class="action-row">
      <%= link_to "Export CSV", export_shg_loans_path(request.query_parameters), class: "secondary-link" %>
      <% if can_bulk_delete_records? %>
        <%= form_with url: bulk_disable_shg_loans_path(request.query_parameters), method: :patch, id: "bulk-disable-loans" do |form| %>
          <%= form.submit "Disable Selected", class: "warning-link", data: { turbo_confirm: "Disable selected loans?" } %>
        <% end %>
      <% end %>
      <% if can_create_records? %><%= link_to "Add Loan", new_shg_loan_path(index_params), class: "primary-link" %><% end %>
      <%= server_search_box(shg_loans_path, placeholder: "Search loans...") %>
    </div>
  </div>

  <% if can_import_loan_data? %>
    <div class="inline-import-panel">
      <%= form_with url: import_shg_loans_path(index_params), multipart: true, class: "inline-import-form" do |form| %>
        <label>
          <span>Import Loan Excel/CSV</span>
          <%= form.file_field :file, accept: ".csv,text/csv,.xlsx,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet", required: true %>
        </label>
        <%= form.submit "Upload Loan Data", class: "primary-button" %>
      <% end %>
    </div>

    <% if @loan_imports.present? %>
      <div class="import-status-list" data-auto-hide-ms="60000">
        <% @loan_imports.each do |loan_import| %>
          <div class="import-status-item <%= loan_import.status %>">
            <div class="import-status-main">
              <strong><%= loan_import.filename %></strong>
              <small>
                #<%= loan_import.id %> · <%= loan_import.status.titleize %> ·
                <%= loan_import.user&.name || "Unknown user" %> ·
                <%= l((loan_import.finished_at || loan_import.updated_at), format: :short) %>
              </small>
            </div>
            <div class="import-status-counts">
              <span>Rows <%= loan_import.total_rows %></span>
              <span>Loans <%= loan_import.total_loans %></span>
              <span>Skipped <%= loan_import.skipped_rows %></span>
            </div>
            <% if loan_import.error_message.present? %>
              <p><%= loan_import.error_message %></p>
            <% end %>
          </div>
        <% end %>
      </div>
    <% end %>
  <% end %>

  <%= form_with url: shg_loans_path, method: :get, class: "filter-grid", data: { controller: "location-select" } do |form| %>
    <%= form.hidden_field :q, value: params[:q] if params[:q].present? %>
    <label><span>From Date</span><%= form.date_field :date_from, value: params[:date_from] %></label>
    <label><span>To Date</span><%= form.date_field :date_to, value: params[:date_to] %></label>
    <% if can_filter_loan_state_district_crp? %>
      <%= multi_filter_select(form, :state_id, "State", @states.map { |state| [state.name, state.id] }, selected_values: filter_param_values(:state_id), data: { location_select_target: "state", action: "location-select#stateChanged" }, placeholder: "All states") %>
      <%= multi_filter_select(form, :district_id, "District", district_filter_options(@districts), selected_values: filter_param_values(:district_id), data: { location_select_target: "district", action: "location-select#districtChanged" }, placeholder: "All districts") %>
    <% end %>
    <%= multi_filter_select(form, :block_id, "Block", block_filter_options(@blocks), selected_values: filter_param_values(:block_id), data: { location_select_target: "block", action: "location-select#blockChanged" }, placeholder: "All blocks") %>
    <%= multi_filter_select(form, :village_id, "Village", village_filter_options(@villages), selected_values: filter_param_values(:village_id), data: { location_select_target: "village", action: "location-select#villageChanged" }, placeholder: "All villages") %>
    <%= multi_filter_select(form, :shg_id, "SHG", shg_filter_options(@shgs), selected_values: filter_param_values(:shg_id), data: { location_select_target: "shg", action: "location-select#shgChanged" }, placeholder: "All SHG") %>
    <% if can_filter_loan_state_district_crp? %>
      <%= multi_filter_select(form, :crp_id, "CRP", user_filter_options(@crps), selected_values: filter_param_values(:crp_id), data: { location_select_target: "crp", action: "location-select#userChanged" }, placeholder: "All CRP") %>
    <% end %>
    <div class="filter-actions">
      <%= link_to "Clear", shg_loans_path(clear_filters: 1), class: "secondary-link" %>
      <%= form.submit "Apply", class: "primary-button" %>
    </div>
  <% end %>

  <div class="form-help full">
    Download will follow the selected date, location and CRP filters.
  </div>

  <div id="<%= ApplicationController::RESULTS_ANCHOR %>" class="searchable-table compact-search-results">
    <% if @loans.blank? %><div class="table-empty-state">No matching loans found.</div><% end %>
    <div class="table-wrap">
    <table class="loan-import-table">
      <thead>
        <tr>
          <% if can_bulk_delete_records? %><th class="select-column"><%= check_box_tag "select_all_loans", "1", false, data: { bulk_select_all: true, bulk_select_form: "bulk-disable-loans" }, aria: { label: "Select all loans on this page" } %></th><% end %>
          <th>SHG</th>
          <th>Member</th>
          <th>Loan No</th>
          <th>State</th>
          <th>District</th>
          <th>Block</th>
          <th>Village</th>
          <th>CRP ID</th>
          <th>CRPName</th>
          <th>Work/Activity</th>
          <th>Product Code</th>
          <th>Disbursement Date</th>
          <th>Loan Status</th>
          <th>Record</th>
          <th>Term Type</th>
          <th>Loan term</th>
          <th>Principal</th>
          <th>Annual Interest Percent</th>
          <th>Interest Amount</th>
          <th>Total Payable</th>
          <th>Principal Collected</th>
          <th>Interest collected</th>
          <th>Paid</th>
          <th>Remaining</th>
          <th>Mobile</th>
          <th>Monthly hh income</th>
          <th>Action</th>
        </tr>
      </thead>
      <tbody>
        <% @loans.each do |loan| %>
          <tr id="loan-<%= loan.id %>">
            <% if can_bulk_delete_records? %><td><%= check_box_tag "ids[]", loan.id, false, form: "bulk-disable-loans", disabled: !loan.active? %></td><% end %>
            <td><%= loan.shg.display_name %></td>
            <td><%= link_to loan.shg_member.name, shg_loan_path(loan, index_params) %></td>
            <td><%= loan.shg_member.loan_no.presence || "-" %></td>
            <td><%= loan.shg.state.name %></td>
            <td><%= loan.shg.district.name %></td>
            <td><%= loan.shg.block.name %></td>
            <td><%= loan.shg.village.name %></td>
            <td><%= loan_crp_identifier(loan).presence || "-" %></td>
            <td><%= loan_crp_name(loan).presence || "-" %></td>
            <td><%= loan.work_activity_name.presence || "-" %></td>
            <td>
              <% if can_manage_shg_loan?(loan) %>
                <%= form_with url: update_product_shg_loan_path(loan, index_params), method: :patch, class: "inline-product-form", data: { turbo: false } do %>
                  <%= select_tag "shg_loan[product_id]", options_for_select(@loan_product_options, loan.product_id), prompt: "Product Code", required: true %>
                  <%= submit_tag "Save", class: "success-link compact-button" %>
                <% end %>
              <% else %>
                <%= product_code_label(loan.product) %>
              <% end %>
            </td>
            <td><%= formatted_import_date(loan.distribution_date) %></td>
            <td><span class="status"><%= loan_status_label(loan) %></span></td>
            <td><span class="status <%= loan.active? ? "approved" : "rejected" %>"><%= loan.active? ? "Active" : "Inactive" %></span></td>
            <td><%= loan.loan_term_type %></td>
            <td><%= loan_term_display(loan) %></td>
            <td><%= number_to_currency(loan.principal_amount, unit: "₹") %></td>
            <td><%= loan.interest_percent.present? ? loan.interest_percent : "-" %></td>
            <td><%= number_to_currency(loan_interest_amount(loan), unit: "₹") %></td>
            <td><%= number_to_currency(loan_total_payable(loan), unit: "₹") %></td>
            <td><%= number_to_currency(loan_principal_collect(loan), unit: "₹") %></td>
            <td><%= number_to_currency(loan_interest_collect(loan), unit: "₹") %></td>
            <td><%= number_to_currency(loan_paid_amount(loan), unit: "₹") %></td>
            <td><%= number_to_currency(loan_remaining_amount(loan), unit: "₹") %></td>
            <td><%= loan.shg_member.mobile.presence || "-" %></td>
            <td><%= loan.shg_member.monthly_income.present? ? number_to_currency(loan.shg_member.monthly_income, unit: "₹") : "-" %></td>
            <td><div class="action-row"><%= link_to "Details", shg_loan_path(loan, index_params) %><%= link_to "Passbook", passbook_shg_loan_path(loan, index_params) %><% if can_manage_shg_loan?(loan) %><%= link_to "Edit", edit_shg_loan_path(loan, index_params) %><% end %><% if can_bulk_delete_records? && loan.active? %><%= button_to "Disable", disable_shg_loan_path(loan, index_params), method: :patch, class: "warning-link", form: { data: { turbo_confirm: "Disable this loan?" } } %><% elsif !loan.active? %><span class="muted-cell">Disabled</span><% end %></div></td>
          </tr>
        <% end %>
      </tbody>
    </table>
    </div>
  </div>
  <%= pagination_controls("loans") %>
</section>
